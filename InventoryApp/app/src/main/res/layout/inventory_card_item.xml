<?xml version="1.0" encoding="utf-8"?>
<!--
    File: inventory_card_item.xml
    Author: Grant McCord
    Class: CS 360 – Mobile App Development
    Date: 2025-12-13
    Purpose: Layout file for a single inventory item card in the RecyclerView of InventoryListActivity.
             This layout contains:
             - MaterialCardView as the outer container
             - Item image
             - Item name
             - Quantity label and text
             - Status pill indicating stock status (e.g., In Stock, Low Stock)
             - Edit menu button (overflow icon) for item actions (edit/remove)
    Notes:
    - Uses ConstraintLayout inside MaterialCardView for flexible positioning.
    - Status pill and quantity dynamically updated by InventoryAdapter.
    - MaterialCardView elevation and corner radius are set to 0 for a flat card look.
    - Intended for use in RecyclerView; all text and image content is populated dynamically.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Item Image -->
        <ImageView
            android:id="@+id/item_image"
            android:layout_width="47dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Item Photo"
            android:scaleType="centerCrop"
            android:src="@drawable/box"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Edit Menu Button -->
        <ImageButton
            android:id="@+id/edit_menu_button"
            android:layout_width="33dp"
            android:layout_height="47dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Options Menu"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Item Name -->
        <TextView
            android:id="@+id/item_name_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/item_image"
            app:layout_constraintEnd_toStartOf="@id/edit_menu_button"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="ACME Part"/>

        <!-- Quantity Label -->

        <!-- Quantity Text -->

        <!-- Status Pill -->
        <TextView
            android:id="@+id/quantity_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:text="QTY:"
            android:textSize="14sp"
            android:textStyle="italic"
            app:layout_constraintBottom_toBottomOf="@id/status_pill"
            app:layout_constraintStart_toEndOf="@id/item_image"
            app:layout_constraintTop_toBottomOf="@id/item_name_text"
            app:layout_constraintVertical_bias="0.0" />

        <TextView
            android:id="@+id/quantity_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/status_pill"
            app:layout_constraintStart_toEndOf="@id/quantity_label"
            app:layout_constraintTop_toTopOf="@id/quantity_label"
            app:layout_constraintVertical_bias="0.0"
            tools:text="150 units" />

        <TextView
            android:id="@+id/status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/pill_instock"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="In Stock"
            android:textColor="@android:color/holo_green_dark"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/quantity_label"
            app:layout_constraintEnd_toStartOf="@id/edit_menu_button"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toEndOf="@id/quantity_text"
            app:layout_constraintTop_toBottomOf="@+id/item_name_text" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
